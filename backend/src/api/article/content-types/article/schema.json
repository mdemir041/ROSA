{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "lang": {
      "type": "string",
      "required": true,
      "default": "TR"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Icerik",
        "Bilgilendirme"
      ],
      "required": true
    },
    "subcategory": {
      "type": "string"
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "imgUrl": {
      "type": "string"
    }
  }
}